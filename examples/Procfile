# Example app for corral: one process per line, "name: command".
# Commands run with /bin/sh in this folder; each runs as a service and is
# restarted when it exits.
ticker: uv run --quiet --script ticker.py
report: uv run --quiet --script report.py
batch: uv run --quiet --script batch.py
# An entry point of a project (a directory with pyproject.toml):
clock: uv run --quiet --project demo-project demo-clock
