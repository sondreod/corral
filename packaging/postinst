#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd corral >/dev/null; then
        adduser --system --group --quiet \
            --home /var/lib/corral --no-create-home corral
    fi
    systemctl enable corral.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl restart corral.service || true
    fi
fi
