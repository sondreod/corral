#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

if [ "$1" = "purge" ]; then
    rm -rf /var/lib/corral /var/cache/corral
    rmdir /etc/corral/scripts /etc/corral 2>/dev/null || true
    if getent passwd corral >/dev/null; then
        deluser --system --quiet corral || true
    fi
fi
