[Unit]
Description=corral - supervised PEP 723 scripts with a web interface
After=network-online.target
Wants=network-online.target

[Service]
User=corral
Group=corral
ExecStart=/usr/bin/corral --config /etc/corral/config.toml
Restart=always
RestartSec=3

# /var/lib/corral (logs, home directory) and /var/cache/corral
# (uv's cache of script environments), both owned by the service user.
StateDirectory=corral
CacheDirectory=corral
Environment=HOME=/var/lib/corral
Environment=UV_CACHE_DIR=/var/cache/corral/uv

# corral stops its scripts itself on SIGTERM; anything still alive
# after the timeout is killed.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
